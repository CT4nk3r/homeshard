# Copy to .env and adjust. Values shown are safe defaults for a local trial.

# ---- Database ----
POSTGRES_DB=homeshard
POSTGRES_USER=homeshard
POSTGRES_PASSWORD=change-me

# ---- Web dashboard ----
WEB_PORT=8010
# Owner account. Without Clerk keys the dashboard runs in single-owner demo mode
# using this identity.
OWNER_EMAIL=you@example.com
# Optional shared secret for agent -> web event posting.
AGENT_TOKEN=
# Optional Clerk auth for multi-user access. Leave blank for demo mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional Vercel Blob token for cloud pack staging.
BLOB_READ_WRITE_TOKEN=

# ---- Agent ----
HOMESHARD_AGENT_ID=homeserver
# Hostname/IP players connect to (e.g. a Tailscale MagicDNS name). Shown in the UI.
HOMESHARD_MAGIC_DNS=
# IP that game container ports bind to. Use your Tailscale IP to keep servers
# private, or 0.0.0.0 to expose on all interfaces.
HOMESHARD_GAME_BIND_IP=0.0.0.0
HOMESHARD_MINECRAFT_IMAGE=itzg/minecraft-server:java21
HOMESHARD_MAX_CONCURRENT_COMMANDS=6

# ---- Host directories ----
# Live instance data. IDENTITY-MOUNTED (same path on host and in the agent
# container). Create it first, e.g.:  sudo mkdir -p /srv/homeshard/instances
HOST_INSTANCES_DIR=/srv/homeshard/instances
# Cold storage (packs, backups, trash). IDENTITY-MOUNTED. Point at a big disk.
HOST_COLD_DIR=/srv/homeshard/cold
# Temp staging for uploaded packs (shared by web + agent).
HOST_STAGING_DIR=./data/staging
# Manually-downloaded "blocked" CurseForge mods. For CurseForge imports this
# MUST be the same host folder PrismLauncher watches (HOMESHARD_PRISM_MISSING_MODS_DIR).
HOST_MISSING_MODS_DIR=./data/missing-mods

# ---- Minecraft CurseForge / Prism import (optional, advanced) ----
# Only needed to auto-import CurseForge modpacks via a PrismLauncher install on
# the host. Leave HOST_PRISM_IMPORT_SCRIPT blank to disable.
#
# Read-only PrismLauncher instances directory on the host.
HOST_PRISM_INSTANCES_DIR=./data/prism-instances
# Absolute host path to this repo's prism-import-host.sh, e.g.:
#   /opt/homeshard/infra/homeserver/prism-import-host.sh
HOST_PRISM_IMPORT_SCRIPT=
# OS user that owns the PrismLauncher setup; the import runs as this user.
HOMESHARD_PRISM_USER=
# X display PrismLauncher renders on (Xvfb/VNC). Defaults to :1.
HOMESHARD_PRISM_DISPLAY=
