# Copy to .env and adjust. Values shown are safe defaults for a local trial.

# ---- Database ----
POSTGRES_DB=homeshard
POSTGRES_USER=homeshard
POSTGRES_PASSWORD=change-me

# ---- Web dashboard ----
WEB_PORT=8010
# Owner account. Without Clerk keys the dashboard runs in single-owner demo mode
# using this identity.
OWNER_EMAIL=you@example.com
# Optional shared secret for agent -> web event posting.
AGENT_TOKEN=
# Optional Clerk auth for multi-user access. Leave blank for demo mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional Vercel Blob token for cloud pack staging.
BLOB_READ_WRITE_TOKEN=

# ---- Agent ----
HOMESHARD_AGENT_ID=homeserver
# Dashboard marks an agent offline after this many seconds without a heartbeat.
# The agent heartbeats every 30 seconds, so 90 tolerates two missed updates.
HOMESHARD_AGENT_OFFLINE_AFTER_SECS=90
# Hostname/IP players connect to (e.g. a Tailscale MagicDNS name). Shown in the UI.
HOMESHARD_MAGIC_DNS=
# IP that game container ports bind to. Use your Tailscale IP to keep servers
# private, or 0.0.0.0 to expose on all interfaces.
HOMESHARD_GAME_BIND_IP=0.0.0.0
# Allocate game servers from this inclusive port range. Preview and live stacks
# on the same host must use non-overlapping ranges.
HOMESHARD_GAME_PORT_START=25600
HOMESHARD_GAME_PORT_END=25699
HOMESHARD_MINECRAFT_IMAGE=itzg/minecraft-server:java21
# JRE image for newer Minecraft (e.g. 26.x). The agent auto-picks between this
# and HOMESHARD_MINECRAFT_IMAGE per pack; classic 1.x packs use the one above.
HOMESHARD_MINECRAFT_IMAGE_MODERN=itzg/minecraft-server:java25
HOMESHARD_MAX_CONCURRENT_COMMANDS=6

# ---- Host directories ----
# Live instance data. IDENTITY-MOUNTED (same path on host and in the agent
# container). Create it first, e.g.:  sudo mkdir -p /srv/homeshard/instances
HOST_INSTANCES_DIR=/srv/homeshard/instances
# Cold storage (packs, backups, trash). IDENTITY-MOUNTED. Point at a big disk.
HOST_COLD_DIR=/srv/homeshard/cold
# Temp staging for uploaded packs (shared by web + agent).
HOST_STAGING_DIR=./data/staging
# Manually-downloaded "blocked" CurseForge mods land here (uploaded via the
# dashboard) and are mounted into servers on deploy. IDENTITY-MOUNTED, so keep
# it absolute. Create it first, e.g.:  sudo mkdir -p /srv/homeshard/missing-mods
HOST_MISSING_MODS_DIR=/srv/homeshard/missing-mods

# ---- CurseForge import (optional) ----
# Set a CurseForge API key to import CurseForge modpack ZIPs directly, with no
# PrismLauncher required. Author-restricted mods that CurseForge blocks from
# automated download are reported in the dashboard for manual upload.
CF_API_KEY=
# Seconds to wait for a CurseForge pack's mods to finish installing (default 1800).
HOMESHARD_CF_INSTALL_TIMEOUT_SECS=1800
