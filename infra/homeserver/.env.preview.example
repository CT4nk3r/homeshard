# Copy to /srv/homeshard/config/preview.env and edit secrets before use.

COMPOSE_PROJECT_NAME=homeshard-preview

# ---- Database ----
POSTGRES_DB=homeshard_preview
POSTGRES_USER=homeshard
POSTGRES_PASSWORD=change-me

# ---- Web dashboard ----
WEB_PORT=8012
OWNER_EMAIL=you@example.com
AGENT_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
BLOB_READ_WRITE_TOKEN=

# ---- Agent ----
HOMESHARD_AGENT_ID=homeserver-preview
HOMESHARD_MAGIC_DNS=
HOMESHARD_GAME_BIND_IP=0.0.0.0
HOMESHARD_GAME_PORT_START=25700
HOMESHARD_GAME_PORT_END=25799
HOMESHARD_MINECRAFT_IMAGE=itzg/minecraft-server:java21
HOMESHARD_MINECRAFT_IMAGE_MODERN=itzg/minecraft-server:java25
HOMESHARD_MAX_CONCURRENT_COMMANDS=2
HOMESHARD_INSTANCE_STATUS_INTERVAL_SECS=15
HOMESHARD_INSTANCE_START_TIMEOUT_SECS=1800
HOMESHARD_BACKUP_TIMEZONE=Europe/Budapest
HOMESHARD_BACKUP_HOUR=6
HOMESHARD_SCHEDULED_BACKUP_RETENTION=14

# ---- Host directories ----
HOST_INSTANCES_DIR=/srv/homeshard/runtime/preview/instances
HOST_COLD_DIR=/srv/homeshard/runtime/preview/cold
HOST_STAGING_DIR=/srv/homeshard/runtime/preview/staging
HOST_MISSING_MODS_DIR=/srv/homeshard/runtime/preview/missing-mods

# ---- CurseForge import (optional) ----
CF_API_KEY=
HOMESHARD_CF_INSTALL_TIMEOUT_SECS=1800
