# Copy to .env.preview. This file is intentionally safe to commit; the copy is ignored.
POSTGRES_DB=homeshard_preview
POSTGRES_USER=homeshard
POSTGRES_PASSWORD=replace-with-a-preview-only-password

WEB_PORT=8011
OWNER_EMAIL=you@example.com
AGENT_TOKEN=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
BLOB_READ_WRITE_TOKEN=

HOMESHARD_AGENT_ID=homeserver-preview
HOMESHARD_AGENT_OFFLINE_AFTER_SECS=90
HOMESHARD_MAGIC_DNS=
HOMESHARD_GAME_BIND_IP=0.0.0.0
HOMESHARD_GAME_PORT_START=25700
HOMESHARD_GAME_PORT_END=25799
HOMESHARD_MINECRAFT_IMAGE=itzg/minecraft-server:java21
HOMESHARD_MINECRAFT_IMAGE_MODERN=itzg/minecraft-server:java25
HOMESHARD_MAX_CONCURRENT_COMMANDS=2
HOMESHARD_BACKUP_TIMEZONE=Europe/Budapest
HOMESHARD_BACKUP_HOUR=6
HOMESHARD_SCHEDULED_BACKUP_RETENTION=14

HOST_INSTANCES_DIR=/srv/homeshard-preview/instances
HOST_COLD_DIR=/srv/homeshard-preview/cold
HOST_STAGING_DIR=/srv/homeshard-preview/staging
HOST_MISSING_MODS_DIR=/srv/homeshard-preview/missing-mods

CF_API_KEY=
HOMESHARD_CF_INSTALL_TIMEOUT_SECS=1800

# deploy.sh overrides these when a release tag is supplied.
HOMESHARD_IMAGE_REPOSITORY=ghcr.io/ct4nk3r/homeshard
HOMESHARD_WEB_IMAGE=homeshard-web:local
HOMESHARD_AGENT_IMAGE=homeshard-agent:local
